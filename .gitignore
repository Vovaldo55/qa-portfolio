# Папки й файли, які Git ігнорує свідомо (не потрапляють у репо)

# Особисті дані — оригінал скриншота з незамазаною поштою
_private/

# Службові скрипти ментора (не частина портфоліо)
_tools/

# Залежності Node — вони величезні й відновлюються командою npm install
node_modules/

# Результати тестів — тимчасові, генеруються щоразу
test-results/
playwright-report/

# Робочі файли, що не є результатом
*.log
package-lock.json.bak

# Матеріали друга для аналізу: важкі файли та розпаковані архіви
*.pptx
*.key
_pptx/
_key/
allgists.json
g1.json
g2.json
gist.html
job.html
